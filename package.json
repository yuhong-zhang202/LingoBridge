{
  "name": "lingobridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "dev:log": "next dev 2>&1 | tee -a dev.log",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "eval:extraction": "npx tsx --conditions=react-server --env-file=.env.local scripts/eval/run-extraction.ts",
    "eval:ranking": "npx tsx --conditions=react-server --env-file=.env.local scripts/eval/run-ranking.ts",
    "eval:ranking:score": "npx tsx scripts/eval/run-ranking-score.ts",
    "remap:links": "npx tsx --conditions=react-server --env-file=.env.local scripts/remap-links.ts",
    "check:secrets": "node --env-file=.env.local scripts/check-no-secrets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.14.0",
    "next": "14.2.35",
    "next-pwa": "^5.6.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jest": "^30.4.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.11",
    "typescript": "^5"
  }
}
