{
  "name": "lingobridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "dev:log": "next dev 2>&1 | tee -a dev.log",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "eval:extraction": "npx tsx --conditions=react-server --env-file=.env.local scripts/eval/run-extraction.ts",
    "eval:ranking": "npx tsx --conditions=react-server --env-file=.env.local scripts/eval/run-ranking.ts",
    "eval:ranking:score": "npx tsx scripts/eval/run-ranking-score.ts",
    "remap:links": "npx tsx --conditions=react-server --env-file=.env.local scripts/remap-links.ts",
    "import:season": "npx tsx --conditions=react-server --env-file=.env.local scripts/import-season.ts",
    "pregen:analyses": "npx tsx --conditions=react-server --env-file=.env.local scripts/pregen-analyses.ts",
    "db:push": "node --env-file=.env.local scripts/db-push.mjs",
    "check:secrets": "node --env-file=.env.local scripts/check-no-secrets.mjs",
    "seed:reference": "node --env-file=.env.local scripts/seed-reference.mjs"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "10.2.9",
    "@supabase/supabase-js": "^2.107.0",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.4",
    "lucide-react": "^1.14.0",
    "next": "15.5.20",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8",
    "eslint-config-next": "15.5.20",
    "jest": "^30.4.2",
    "pg": "^8.22.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.11",
    "typescript": "^5"
  }
}
