{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(npm run eval:*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm run check:*)",
      "Bash(npm install *)",
      "Bash(npx tsx scripts/eval/*)",
      "Bash(npx tsc *)",
      "Bash(npx jest *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(bash scripts/eval/loop/*)",

      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(jq *)",
      "Bash(xxd *)",
      "Bash(echo *)",
      "Bash(sed *)",
      "Bash(diff *)",
      "Bash(time *)",

      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git stash*)",
      "Bash(git branch*)",

      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(rm *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npm run remap:*)",
      "Bash(npx tsx scripts/remap-links.ts*)",
      "Bash(npx tsx scripts/apply-0017.ts*)",
      "Bash(npx tsx scripts/set-topic-only.ts*)"
    ],
    "deny": [
      "Bash(sudo *)"
    ],
    "defaultMode": "acceptEdits"
  }
}
