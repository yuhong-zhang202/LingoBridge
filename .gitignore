# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev.log

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# eval 跑分产物（每跑一次堆一个带时间戳文件；保留 scripts/eval/golden 金标集与 run-extraction.ts）
/scripts/eval/results/

# LLM 原始输出留存（LLM_RAW_LOG_DIR 指向此目录；含用户故事原文，永不入库）
/.llm-raw/

# next-pwa 构建产物
public/sw.js
public/sw.js.map
public/workbox-*.js
public/worker-*.js
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Claude Code 个人本地覆盖（团队共用的在 .claude/settings.json）
.claude/settings.local.json

# 金标迁移备份，不入库
*.bak

# ── 本地素材/取证，不入库（2026-08-13）──────────────────────────────
# 临时/：内含从生产库导出的查询结果（有真实用户邮箱）+ 21MB 第三方题库 PDF。
#   用户个人数据一旦进 git 历史就删不掉，且题库 PDF 是第三方版权材料。
临时/
# vercel/：账号恢复码（secret）。项目已改用 Zeabur，这个目录本就是历史遗留，
#   建议直接移出仓库目录，别只靠 gitignore —— 忽略只挡 git，挡不住打包/同步/误操作。
vercel/
# 头像/：随手下载的图片素材（images.jpeg 之类），非项目资产。
头像/

# ── 与 main 对齐（本分支 .gitignore 落后 origin/main，故补齐；2026-08-13）──────
# main 上早已忽略这两处，本分支因陈旧而没有，导致 91ecd29 误把它们提交了进来。
准确率/
网站/
