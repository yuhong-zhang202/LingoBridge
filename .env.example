NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role —— 服务端专用管理员密钥，绝不加 NEXT_PUBLIC_ 前缀，绝不提交 git
SUPABASE_SERVICE_ROLE_KEY=

# 千问 / DashScope —— 服务端专用密钥，绝不加 NEXT_PUBLIC_ 前缀，绝不提交 git
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# Anthropic / Claude —— 服务端专用密钥，绝不加 NEXT_PUBLIC_ 前缀，绝不提交 git
ANTHROPIC_API_KEY=

# 豆包 ASR —— 服务端专用密钥，绝不加 NEXT_PUBLIC_ 前缀，绝不提交 git
DOUBAO_ASR_APP_ID=
DOUBAO_ASR_ACCESS_TOKEN=

# 管理员邮箱白名单（英文逗号分隔，如 a@x.com,b@y.com）—— 成本看板等敏感接口鉴权用，服务端专用，绝不加 NEXT_PUBLIC_
ADMIN_EMAILS=

# ── 调试开关（含用户隐私面，默认全关，生产不要开）─────────────────────────────
# LLM 原始输出留存目录。留空=不留存（生产默认）。
# 非空时把每次调用的【完整 prompt + 原始输出】落盘成 JSONL —— 含用户故事原文。
# 落盘时目录 0o700 / 文件 0o600。务必只指向 .gitignore 内的本地目录。
# LLM_RAW_LOG_DIR=

# =1 时把模型原始输出打进 console（仅失败路径）。模型输出含故事碎片：
# 重排的 reason 会复述故事细节、萃取的证据字段会引用原文。
# ⚠️ 生产环境物理失效（env-server.ts 里与 NODE_ENV !== 'production' 与运算），设了也不生效。
# LLM_DEBUG=
