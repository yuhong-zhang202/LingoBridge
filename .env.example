NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role —— 服务端专用管理员密钥，绝不加 NEXT_PUBLIC_ 前缀，绝不提交 git
SUPABASE_SERVICE_ROLE_KEY=

# Supabase 数据库直连串（Dashboard → Settings → Database → Connection string，Session pooler / 5432）
# 仅供 `npm run db:push` 迁移器直连跑 DDL（非 REST），本地/CI 用；绝不加 NEXT_PUBLIC_、绝不提交 git
SUPABASE_DB_URL=

# 千问 / DashScope —— 服务端专用密钥，绝不加 NEXT_PUBLIC_ 前缀，绝不提交 git
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# Anthropic / Claude —— 服务端专用密钥，绝不加 NEXT_PUBLIC_ 前缀，绝不提交 git
ANTHROPIC_API_KEY=

# 豆包 ASR —— 服务端专用密钥，绝不加 NEXT_PUBLIC_ 前缀，绝不提交 git
DOUBAO_ASR_APP_ID=
DOUBAO_ASR_ACCESS_TOKEN=

# 管理员邮箱白名单（英文逗号分隔，如 a@x.com,b@y.com）—— 成本看板等敏感接口鉴权用，服务端专用，绝不加 NEXT_PUBLIC_
ADMIN_EMAILS=

# 同意审计痕迹哈希盐 —— 服务端专用密钥，绝不加 NEXT_PUBLIC_ 前缀，绝不提交 git
# 删号时写 consent_audit（migration 0025）的 email_hash = sha256(邮箱规范化 + 本 salt)，用于日后自证用户曾同意过。
# ⚠️ 必填：未配置则删号接口整体报 500（在删任何数据之前中止，账号无损）。生产上线前必须在 Zeabur 配好。
# ⚠️ 一旦启用不可更换：换 salt 会让已写入的 email_hash 全部失配、无法再比对。建议用 openssl rand -hex 32 生成。
CONSENT_HASH_SALT=

# ── 功能开关 ─────────────────────────────
# 重排打分：=1 启用「AI 分维度 + 代码按权重合成」新路径；留空/非 1 = 现状单一总分（默认，现网行为不变）。
# 第一阶段默认关；待第二阶段权重 LOSO 拟合 + 红线验证通过后，再由产品方开启。
# RANKING_DIMENSIONAL=

# 匹配存档：默认启用「匹配一次→冻结存档→重访读档、不再跑模型」（消除刷新看到不同高/中/低的漂浮）。
# 设为 0 = 一键回滚到每次重访都重跑模型的旧行为（快照表留着无害，不必回退迁移）。未设/非 0 = 启用。
# MATCH_SNAPSHOT_ENABLED=

# QA 流量标记 token（可选，服务端专用，绝不加 NEXT_PUBLIC_）。产品方自测时访问 ?qa=<本值>，
# 埋点写库时把 flow_events.is_qa 标真，离线算漏斗时剔除自测流量。留空 = 该通道整体不生效（fail-closed，
# 任何请求头都不匹配）；此时仍可靠内部账户名册 isInternalAccount 标记。
# ⚠️ 纯统计用途：值由客户端携带、可伪造，永久禁止用于额度/权限/计费/RLS 判定。
# QA_TRAFFIC_TOKEN=

# ── 调试开关（含用户隐私面，默认全关，生产按需开）─────────────────────────────
# =1 开启原始输出留证入库（llm_raw_logs / asr_raw_logs，见 migration 0020）；未设/非 1 = 关（默认）。
# 开启后把每次 LLM 调用的【完整 prompt + 原始输出】、每次 ASR 的【转写原文】写入数据库 —— 含用户原文。
# 靠表 RLS（service_role 唯一入口）+ pg_cron 30 天过期兜底；生产内测置 1。
# RAW_LOG_ENABLED=

# =1 时把模型原始输出打进 console（仅失败路径）。模型输出含故事碎片：
# 重排的 reason 会复述故事细节、萃取的证据字段会引用原文。
# ⚠️ 生产环境物理失效（env-server.ts 里与 NODE_ENV !== 'production' 与运算），设了也不生效。
# LLM_DEBUG=
